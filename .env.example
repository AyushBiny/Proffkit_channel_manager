# Supabase Connection (Port 6543 for Next.js Pooler, Port 5432 for Cloud Worker)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DATABASE_POOLER_URL="postgresql://postgres.your-project:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_DIRECT_URL="postgresql://postgres.your-project:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# 24/7 Cloud Worker Queue & AES-256-GCM Master Vault Key (64 hex chars = 32 bytes)
REDIS_URL="redis://localhost:6379"
MASTER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Superadmin Maintenance Team Alerts
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_OPS_CHAT_ID="your-ops-chat-id"
