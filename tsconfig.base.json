{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@proffkit/db-types": ["packages/db-types/src/index.ts"],
      "@proffkit/business-logic": ["packages/business-logic/src/index.ts"],
      "@proffkit/shared-ui": ["packages/shared-ui/src/index.tsx"]
    }
  }
}
